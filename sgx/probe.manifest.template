# Gramine manifest for the CLEAN enclave probe.
#
# /app holds only the application; build products (manifests, signatures) stay
# outside it. This matters: sgx.trusted_files measures every file under a
# trusted directory, so a stray artifact in the measured tree changes
# MRENCLAVE. The measurement covers the manifest too, which is why it names a
# configured image and not merely a source tree.
#
# The measurement this produces covers the files listed as trusted below, so
# MRENCLAVE names an image rather than a source tree. /sealed is an encrypted
# mount whose key is derived from that measurement, which is what makes the
# sealed state of Assumption 2 a hardware property rather than a convention.

libos.entrypoint = "{{ entrypoint }}"
loader.entrypoint.uri = "file:{{ gramine.libos }}"
loader.log_level = "{{ log_level }}"

loader.env.LD_LIBRARY_PATH = "/lib:{{ arch_libdir }}:/usr/lib:/usr{{ arch_libdir }}"
loader.env.PYTHONHOME = "/usr"
loader.env.PYTHONPATH = "/app:/usr/lib/python3/dist-packages"
loader.env.PYTHONDONTWRITEBYTECODE = "1"
loader.insecure__use_cmdline_argv = true

fs.mounts = [
  { path = "/lib",           uri = "file:{{ gramine.runtimedir() }}" },
  { path = "{{ arch_libdir }}", uri = "file:{{ arch_libdir }}" },
  { path = "/usr",           uri = "file:/usr" },
  { path = "/app",           uri = "file:/app" },
  { path = "/sealed", uri = "file:/sealed", type = "encrypted", key_name = "_sgx_mrenclave" },
]

sgx.debug = true
sgx.edmm_enable = false          # this CPU reports SGX2 false
sgx.enclave_size = "{{ enclave_size }}"
sgx.max_threads = 8
sgx.remote_attestation = "{{ ra_type }}"

sgx.trusted_files = [
  "file:{{ gramine.libos }}",
  "file:{{ gramine.runtimedir() }}/",
  "file:{{ arch_libdir }}/",
  "file:/usr/{{ arch_libdir }}/",
  "file:/usr/bin/python3.10",
  "file:/usr/lib/python3.10/",
  "file:/usr/lib/python3/dist-packages/",
  "file:/app/",
]

sgx.allowed_files = [
  "file:/sealed/",
]
